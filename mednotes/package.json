{
  "name": "mednotes",
  "version": "0.1.0",
  "private": true,
  "description": "Local offline medical notes with semantic search",
  "author": "Medica",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac dir --arm64",
    "dist:mac": "electron-builder --config electron-builder.yml --mac dmg --universal",
    "dist:win": "electron-builder --config electron-builder.yml --win nsis --x64 --arm64",
    "test": "node --test tests/test-save-post.js tests/test-embedding.js tests/test-search.js",
    "test:storage": "node --test tests/test-save-post.js",
    "test:embedding": "node --test tests/test-embedding.js",
    "test:search": "node --test tests/test-search.js",
    "test:ui": "node tests/test-ui-clicks.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.55.0"
  }
}
